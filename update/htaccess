# ==========================
# .htaccess — luxuryhomesofindia.in
# Canonicalization & indexing cleanups
# Place this file in: public_html/.htaccess  (Apache)
# ==========================

# Enable rewrites
RewriteEngine On

# --------------------------
# 1) Force HTTPS
# --------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --------------------------
# 2) Force apex (non-www)
# --------------------------
RewriteCond %{HTTP_HOST} ^www\.luxuryhomesofindia\.in$ [NC]
RewriteRule ^ https://luxuryhomesofindia.in%{REQUEST_URI} [R=301,L]

# --------------------------
# 3) Strip tracking/query junk to prevent duplicate URLs
#    (keeps the path but clears the query string)
# --------------------------
RewriteCond %{QUERY_STRING} (^|&)(utm_[^&]+|fbclid|gclid|msclkid|ref|_branch_match_id) [NC]
RewriteRule ^ %{REQUEST_URI}? [R=301,L]

# --------------------------
# 4) Normalize home URLs
#    /index.html or /home.html -> /
# --------------------------
RewriteRule ^(index|home)\.html?$ / [R=301,L]

# --------------------------
# 5) Prevent .html trailing-slash duplicates
#    e.g., /about.html/  -> /about.html
# --------------------------
RewriteRule ^(.+)\.html/$ /$1.html [R=301,L]

# --------------------------
# 6) If a clean path matches an existing .html file,
#    redirect it to the .html canonical
#    e.g., /about  -> /about.html   (only if /about.html exists)
# --------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ /$1.html [R=301,L]

# --------------------------
# 7) Trailing slash normalizer for non-file, non-directory requests
#    (Optional) Uncomment to remove trailing slashes globally, EXCEPT for real directories
# --------------------------
#RewriteCond %{REQUEST_FILENAME} !-d
#RewriteCond %{REQUEST_URI} .+/$
#RewriteRule ^(.+?)/$ /$1 [R=301,L]

# --------------------------
# 8) 410 (Gone) for intentionally removed pages
#    Faster de-indexing than 404. Add lines for deleted URLs.
# --------------------------
# Redirect 410 /old-brochure.html
# Redirect 410 /obsolete-project.html

# --------------------------
# 9) Security/consistency headers (optional but helpful)
# --------------------------
#Header always set X-Content-Type-Options "nosniff"
#Header always set X-Frame-Options "SAMEORIGIN"
#Header always set Referrer-Policy "strict-origin-when-cross-origin"

